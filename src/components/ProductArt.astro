---
/** Small invented packshot drawn in SVG: a bottle, a roll, a bag or a box depending on the category. */
type Props = { category: string; size?: number };
const { category, size = 72 } = Astro.props;
const shape = ['papel'].includes(category)
  ? 'roll'
  : ['residuos'].includes(category)
    ? 'bag'
    : ['utensilios', 'aromas'].includes(category)
      ? 'box'
      : 'bottle';
---

<svg class="product-art" width={size} height={size} viewBox="0 0 72 72" aria-hidden="true" focusable="false">
  <rect width="72" height="72" rx="14" fill="var(--cobalt-50)"></rect>
  {
    shape === 'bottle' && (
      <g>
        <rect x="30" y="10" width="12" height="8" rx="2" fill="var(--yellow)" />
        <path d="M27 20h18l4 8v30a4 4 0 0 1-4 4H27a4 4 0 0 1-4-4V28z" fill="var(--cobalt)" />
        <rect x="27" y="34" width="18" height="14" rx="2" fill="#fff" />
        <rect x="30" y="38" width="12" height="2" rx="1" fill="var(--cobalt)" />
        <rect x="30" y="42" width="8" height="2" rx="1" fill="var(--yellow)" />
      </g>
    )
  }
  {
    shape === 'roll' && (
      <g>
        <rect x="16" y="18" width="40" height="38" rx="6" fill="var(--cobalt)" />
        <ellipse cx="36" cy="18" rx="20" ry="6" fill="#fff" />
        <ellipse cx="36" cy="18" rx="6" ry="2" fill="var(--yellow)" />
        <rect x="16" y="34" width="40" height="8" fill="var(--yellow)" />
      </g>
    )
  }
  {
    shape === 'bag' && (
      <g>
        <path d="M22 22h28l4 36H18z" fill="var(--cobalt)" />
        <path d="M28 22c0-8 16-8 16 0" stroke="var(--yellow)" stroke-width="4" fill="none" />
        <rect x="26" y="36" width="20" height="10" rx="2" fill="#fff" />
      </g>
    )
  }
  {
    shape === 'box' && (
      <g>
        <path d="M14 26 36 16l22 10v24L36 60 14 50z" fill="var(--cobalt)" />
        <path d="M14 26 36 36l22-10M36 36v24" stroke="#fff" stroke-width="2" fill="none" />
        <rect x="40" y="40" width="12" height="6" rx="1" fill="var(--yellow)" transform="rotate(-24 46 43)" />
      </g>
    )
  }
</svg>
